#!/usr/bin/make -f

# Debian convention: ship a shared library. The TESTING block resolves
# googletest/curl from the system via find_package, so it is disabled here;
# enable it against the system packages if you want to build the tests.
%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- -DBUILD_SHARED_LIBS=ON -DTESTING=OFF
